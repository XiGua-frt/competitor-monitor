# amazonCrawler 环境变量示例 — 复制为 .env 后按需修改
# 命名规则: AMZ_ 前缀优先，同名无前缀变量亦可（AMZ_MARKETPLACE > MARKETPLACE > 默认值）

# ---- 数据库 (PostgreSQL 生产 / SQLite 备用) ----
# 完整连接串（优先级最高）
DATABASE_URL=postgresql+psycopg2://crawler:secret@localhost:5432/amazon_crawler
# 无 DATABASE_URL 时用以下分项拼接
AMZ_POSTGRES_HOST=localhost
AMZ_POSTGRES_PORT=5432
AMZ_POSTGRES_DB=amazon_crawler
AMZ_POSTGRES_USER=crawler
AMZ_POSTGRES_PASSWORD=secret
# 备用 SQLite 路径（本地无 PG 时跑通链路）
AMZ_DB_PATH=data/amazon_crawler.sqlite3

# ---- Redis（限流 / 日配额；不可用时降级本地计数）----
AMZ_REDIS_HOST=localhost
AMZ_REDIS_PORT=6379
AMZ_REDIS_PASSWORD=
AMZ_REDIS_DB=0

# ---- 代理 ----
AMZ_PROXY_ENABLED=false
AMZ_PROXY_HOST=127.0.0.1
AMZ_PROXY_PORT=7892
AMZ_PROXY_TYPE=http

# ---- 请求节奏（秒）----
AMZ_REQUEST_MIN_INTERVAL=8
AMZ_REQUEST_MAX_INTERVAL=15

# ---- 日配额 ----
AMZ_DAILY_QUOTA_ASINS=200
AMZ_DAILY_QUOTA_SEARCH=50

# ---- 反爬软冷却（503/captcha 后暂停秒数）----
AMZ_SOFT_COOLDOWN_SECONDS=3600

# ---- 目标站点 / 时区 ----
AMZ_MARKETPLACE=www.amazon.com
AMZ_TIMEZONE=America/New_York

# ---- 日志 / 导出 ----
AMZ_LOG_LEVEL=INFO
AMZ_LOG_FILE=logs/amazon_crawler.log
AMZ_EXPORT_DIR=exports
