{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "amazon-product-record-v1.schema.json",
  "title": "Amazon Product Record v1 (统一数据库外部验证层)",
  "description": "Amazon 前台商品采集记录格式，对齐 amzpy 产出样例（B0DLQ8MVF7, 2026-10-08）。跨平台统一记录：platform='amazon' 时 TikTok 专属槽位允许为 null。",
  "type": "object",
  "required": ["platform", "external_id", "source_url", "title", "fetched_at", "target_status_code"],
  "additionalProperties": true,
  "properties": {
    "platform": { "const": "amazon", "description": "平台标识，统一记录必填" },
    "external_id": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^B0[A-Z0-9]{8}$", "description": "ASIN，业务主键" },
    "source_url": { "type": "string", "format": "uri", "description": "商品详情页 URL" },
    "title": { "type": "string", "maxLength": 1000 },
    "description": { "type": ["string", "null"], "description": "卖点文案，feature bullets 以 \\n 连接" },
    "cover_url": { "type": ["string", "null"], "format": "uri" },
    "media_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "fetched_at": { "type": "string", "format": "date-time", "description": "采集时间，ISO8601 UTC 带微秒与时区" },
    "published_at": { "type": ["string", "null"], "format": "date-time", "description": "Amazon 恒为 null，跨平台兼容槽位" },
    "author_id": { "type": ["string", "null"], "description": "Amazon 恒为 null，跨平台兼容槽位" },
    "hashtags": { "type": "array", "items": { "type": "string" }, "description": "Amazon 恒为空数组" },
    "target_status_code": { "type": "string", "enum": ["full", "partial", "failed"], "description": "采集完整度。partial=关键字段有缺失" },
    "stats": {
      "type": "object",
      "description": "社交统计统一槽位，Amazon 全 null（无对应概念）",
      "properties": {
        "views": { "type": ["integer", "null"] },
        "likes": { "type": ["integer", "null"] },
        "comments": { "type": ["integer", "null"] },
        "shares": { "type": ["integer", "null"] },
        "collections": { "type": ["integer", "null"] }
      }
    },
    "commerce": {
      "type": "object",
      "required": ["price", "currency"],
      "properties": {
        "price": { "type": "number", "exclusiveMinimum": 0, "description": "展示价 USD，非定制订单最终价（见 price_scope）" },
        "currency": { "type": "string", "enum": ["USD"] },
        "availability_text": { "type": ["string", "null"] },
        "brand": { "type": ["string", "null"] },
        "seller_name": { "type": ["string", "null"] },
        "rating": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "rating_count": { "type": ["integer", "null"], "minimum": 0 },
        "written_review_count": { "type": ["integer", "null"] },
        "date_first_available": { "type": ["string", "null"], "format": "date", "description": "标准化 ISO 日期 YYYY-MM-DD" },
        "date_first_available_raw": { "type": ["string", "null"], "description": "页面原文，如 November 1, 2024" },
        "best_sellers_rank_raw": { "type": ["string", "null"], "description": "BSR 页面原文，审计用，勿解析" },
        "best_sellers_ranks": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["category", "rank"],
            "properties": {
              "category": { "type": "string" },
              "rank": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "recent_purchase_text": { "type": ["string", "null"] },
        "recent_purchase_display": { "type": ["string", "null"] }
      }
    },
    "collection_conditions": {
      "type": "object",
      "description": "本次采集的采集条件与变体绑定状态",
      "properties": {
        "status": { "type": "string", "enum": ["confirmed", "unconfirmed"] },
        "comparison_ready": { "type": "boolean" },
        "region_verified": { "type": "boolean" },
        "requested_asin": { "type": "string" },
        "expected_variant": { "type": ["string", "null"] },
        "variant_status": { "type": "string", "enum": ["fixed", "not_fixed"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "expected": {
          "type": "object",
          "properties": {
            "marketplace": { "type": "string" },
            "currency": { "type": "string" },
            "language": { "type": "string" },
            "delivery_postcode": { "type": "string" },
            "price_scope": { "type": "string", "enum": ["displayed_product_price_not_final_customized_order"] },
            "variant_policy": { "type": "string", "enum": ["record_selected_then_fix_per_product"] }
          }
        },
        "observed": {
          "type": "object",
          "properties": {
            "asin": { "type": "string" },
            "page_url": { "type": "string", "format": "uri" },
            "marketplace": { "type": "string" },
            "language": { "type": "string" },
            "currency_preference": { "type": "string" },
            "displayed_currency": { "type": "string" },
            "delivery_location": { "type": "string" },
            "color": { "type": ["string", "null"] },
            "size": { "type": ["string", "null"] },
            "fit_type": { "type": ["string", "null"] },
            "size_option_asin": { "type": ["string", "null"] },
            "variant_evidence": {
              "type": ["object", "null"],
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "value": { "type": "string" },
                  "source": { "type": "string", "enum": ["embedded_selected_dimension"] },
                  "binding": { "type": "string", "enum": ["unverified", "verified"] },
                  "associated_identity": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "字段级溯源：每个关键值来自页面哪个 DOM 位置",
      "properties": {
        "price_raw": { "type": ["string", "null"], "description": "价格原文，如 $14.99" },
        "price_source": { "type": ["string", "null"] },
        "price_missing_reason": { "type": ["string", "null"] },
        "price_scope": { "type": ["string", "null"] },
        "rating_count_raw": { "type": ["string", "null"] },
        "description_source": { "type": ["string", "null"] },
        "import_source": { "type": ["string", "null"], "description": "本地证据 HTML 路径，仅调试用，交接外发时脱敏" },
        "media_urls_complete": { "type": ["boolean", "null"] },
        "us_preferences_verified": { "type": ["boolean", "null"] },
        "currency_preference": { "type": ["string", "null"] },
        "delivery_location": { "type": ["string", "null"] }
      }
    },
    "relevance": {
      "type": "object",
      "description": "选品相关性判定（规则引擎输出，pet-apparel 垂类）",
      "properties": {
        "status": { "type": "string", "enum": ["related", "unrelated", "unknown"] },
        "product_scope": { "type": ["string", "null"], "enum": ["pet_specific", "generic", null] },
        "target": { "type": ["string", "null"] },
        "stage": { "type": ["string", "null"] },
        "method": { "type": ["string", "null"] },
        "rule_version": { "type": ["string", "null"], "description": "如 pet-apparel-v1，规则可重跑复现" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["signal", "matched_text", "source"],
            "properties": {
              "signal": { "type": "string", "enum": ["apparel", "customization", "pet_portrait"] },
              "matched_text": { "type": "string" },
              "excerpt": { "type": "string" },
              "source": { "type": "string", "enum": ["title", "description"] }
            }
          }
        }
      }
    },
    "search": {
      "type": "object",
      "description": "发现上下文：该商品由哪次搜索命中",
      "properties": {
        "keyword": { "type": ["string", "null"] },
        "selected_result_position": { "type": ["integer", "null"], "minimum": 1 },
        "position_scope": { "type": ["string", "null"] },
        "is_sponsored": { "type": ["boolean", "null"] }
      }
    },
    "storage": {
      "type": "object",
      "description": "采集侧运行时簿记，消费方只读；profile 为采集配置指纹",
      "properties": {
        "profile": { "type": ["string", "null"] },
        "snapshot_id": { "type": ["string", "null"], "description": "本次采集的幂等/去重指纹" },
        "last_valid_price": {
          "type": ["object", "null"],
          "properties": {
            "price": { "type": "number" },
            "currency": { "type": "string" },
            "observed_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
