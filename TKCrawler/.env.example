# ============================================
# TikTok 跨境选品爬虫系统 - 环境配置模板
# ============================================

# -------------------- TikTok 账号配置 --------------------
# 用于获取登录态Cookie (camoufox浏览器自动登录)
TIKTOK_USERNAME=your_username
TIKTOK_PASSWORD=your_password

# -------------------- 数据库配置 --------------------
# 完整连接串 (可选): 设置后优先于下方 POSTGRES_* 变量
# DATABASE_URL=postgresql://crawler:secret_password@localhost:5432/tiktok_crawler
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tiktok_crawler
POSTGRES_USER=crawler
POSTGRES_PASSWORD=secret_password

# -------------------- Redis 配置 --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -------------------- 代理配置 (可选) --------------------
# 使用本地代理出口 (如Clash/Surge)
PROXY_ENABLED=true
PROXY_HOST=127.0.0.1
PROXY_PORT=7892
PROXY_TYPE=http  # http/socks5

# -------------------- 速率控制配置 --------------------
# 通用请求间隔 (秒, src/common/config.py 读取)
REQUEST_MIN_INTERVAL=5
REQUEST_MAX_INTERVAL=8

# 采集器专用间隔与软冷却 (秒, src/scrapers/base_scraper.py 读取,
# 商品页风控要求 7-10s, 优先于上面的通用值)
SCRAPER_REQUEST_MIN_INTERVAL=7
SCRAPER_REQUEST_MAX_INTERVAL=10
SCRAPER_SOFT_COOLDOWN_SECONDS=3600  # 429/403 后软冷却时长

# 每日配额限制 (防止账号风险)
DAILY_QUOTA_PRODUCTS=200      # 商品页
DAILY_QUOTA_VIDEOS=500         # 视频页
DAILY_QUOTA_CREATORS=100       # 达人页
DAILY_QUOTA_HASHTAGS=50        # 话题页

# -------------------- 反检测配置 --------------------
# 主通道: curl_cffi / browser
PRIMARY_CHANNEL=curl_cffi

# curl_cffi 指纹版本
CURL_CFFI_IMPERSONATE=chrome131

# camoufox 浏览器配置
BROWSER_HEADLESS=true
# BROWSER_EXECUTABLE_PATH 留空使用 bundled 版本 (行内注释会被 dotenv 当成值, 注释必须单独一行)
BROWSER_EXECUTABLE_PATH=

# -------------------- 调度配置 --------------------
# 快照周期 (天)
SNAPSHOT_INTERVAL_DAYS=2

# 任务重试配置
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE=60  # 秒

# -------------------- 外部数据源配置 (可选) --------------------
# 1688 (阿里巴巴开放平台)
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# Kalodata / EchoTik (第三方工具, P1可选)
KALODATA_API_KEY=
ECHOTIK_API_KEY=

# -------------------- 日志配置 --------------------
LOG_LEVEL=INFO  # DEBUG/INFO/WARNING/ERROR
LOG_FILE=logs/crawler.log

# -------------------- 监控配置 --------------------
# Prometheus metrics端口
METRICS_PORT=9090

# Sentry (错误追踪, 可选)
SENTRY_DSN=

# Grafana 管理员密码 (docker-compose.yml 读取, 默认 admin)
GRAFANA_PASSWORD=admin

# -------------------- 导出配置 --------------------
EXPORT_DIR=exports

# -------------------- 其他 --------------------
# 时区
TIMEZONE=America/Los_Angeles  # 美区TikTok

# Debug模式 (开启后输出详细日志)
DEBUG=false
